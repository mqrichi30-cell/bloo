# Copiar a .env y completar. NUNCA commitear .env real.

# SQLite local
DATABASE_URL="file:./dev.db"

# Secreto de la cookie de sesión (iron-session). Generar uno nuevo por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="genera-un-secreto-de-32-bytes-en-base64-aqui"

# Cuentas de seed (prisma/seed.ts). Cambiar el password tras el primer login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esta-clave-admin"
ADMIN_NOMBRE="Cristhofer"
# Opcional: sin esto el usuario queda sin correo (se puede cargar luego desde /perfil).
ADMIN_EMAIL=""

VENDEDOR_USERNAME="vendedor"
VENDEDOR_PASSWORD="cambiar-esta-clave-vendedor"
VENDEDOR_NOMBRE="Vendedor"
VENDEDOR_EMAIL=""

NODE_ENV="development"

# URL pública de la app, usada para armar el link de "olvidé mi contraseña"
# (ver app/api/auth/forgot/route.ts). Default si se omite: bloo-panel.netlify.app.
APP_URL="https://bloo-panel.netlify.app"

# SMTP saliente para "olvidé mi contraseña" (lib/mailer.ts). Cuenta:
# bhawks.services@gmail.com con una App Password de Gmail (no la clave normal).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="bhawks.services@gmail.com"
SMTP_PASS=""
SMTP_FROM="bhawks.services@gmail.com"

# Solo si hay un reverse proxy de confianza delante (que sanitiza/sobrescribe
# X-Forwarded-For antes de que llegue a la app). Sin esto en "true", la app
# IGNORA X-Forwarded-For para cualquier decisión de seguridad (es falsificable
# por el cliente). Dejar sin configurar en dev / detrás de localhost.
TRUST_PROXY_HEADERS="false"
# Si TRUST_PROXY_HEADERS=true, lista de IPs de proxy conocidas separadas por coma.
TRUSTED_PROXY_IPS=""

# Secreto compartido de los crons y del worker de imágenes (header
# x-cron-secret). OBLIGATORIO para /api/cron/marketplace-sync y /api/imagegen/**:
# sin él esas rutas responden 503 (fail-closed). Mismo valor en Netlify (sitio
# + funciones programadas) y en los secrets del GitHub Action del worker.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# Messenger de la Página de bloo (app/api/meta/webhook, lib/meta/**).
# Token que uno inventa y pega también en el panel de Meta (verificación GET).
META_VERIFY_TOKEN=""
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256.
META_APP_SECRET=""
# Page Access Token de larga duración de la Página (para responder).
META_PAGE_ACCESS_TOKEN=""

# Respuestas IA de seguimiento (docs/MARKETPLACE_COPY.md §2).
ANTHROPIC_API_KEY=""

# URL del proyecto Supabase donde el worker de imágenes sube las fotos
# generadas (Storage público). La app SOLO la usa para validar que cada
# publicUrl que reporta el worker sea de ese Storage (lib/marketplace/hosts.ts);
# sin ella, /api/imagegen/[id]/result rechaza toda imagen 'lista'. La
# SUPABASE_SERVICE_KEY NO va en la app: solo en los secrets del GitHub Action.
SUPABASE_URL=""
