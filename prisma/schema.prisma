// bloo — schema de datos
// Dinero SIEMPRE entero en céntimos (x100). Nunca Float/Decimal para montos.
// Ventas y lotes son append-only: no se editan filas históricas, se corrige
// con Return + AuditLog.
//
// VENTA = TICKET + ÍTEMS: una Sale es un ticket (varios modelos posibles),
// con UN monto total tecleado por Cris (no por par). Cada modelo/cantidad
// vendido vive en SaleItem. Ver Sale/SaleItem más abajo.
//
// COSTEO: CPPM (costo promedio ponderado móvil) POR SKU. El costo vive en
// `Lote` (inmutable), y cada lote apunta al `Model` que recibió sus unidades
// (`Lote.modelId`). El costo unitario que se le "cobra" a cada ítem de venta
// (costoUnitSnapshotCent en SaleItem) es
// SUM(Lote.costoTotalCent) / SUM(Lote.unidades) DE LOS LOTES DE ESE MODELO,
// leído en el momento de vender. Ver lib/lote.ts.
//
// HISTORIA (auditoría 16-ago-2026): antes el pool era GLOBAL — promediaba
// lentes y estuches en un solo costo unitario, y le cobraba ese promedio a
// todos los ítems de un ticket sin importar el modelo. Con 63 lentes a
// ₡102.635,42 y 37 estuches a ₡72.004,92, el promedio global daba ₡1.746,40/u
// cuando el lente real costaba ₡1.629,13 y el estuche ₡1.946,08: sobrecosteaba
// el lente y subcosteaba el estuche (cuyo margen real contra un PVP de ₡2.000
// era 2,7%, no el 12,7% que aparentaba). NO volver a un pool global.
// (Esas cifras son las del día de la auditoría. El CPPM se mueve con cada
// lote: tras la orden NHCR608282322226 del 28-ago-2026 el lente quedó en
// ₡1.690,78 y el estuche estándar en ₡1.840,02. El costo vigente se consulta
// con lib/lote.ts#getUnitCostByModelCent, nunca copiando un número de acá.)

generator client {
  provider      = "prisma-client-js"
  // native = dev local; rhel-openssl-3.0.x = Netlify Functions (AWS Lambda AL2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums se validan como string en Zod/TS
// (Role = "admin" | "vendedor", SaleStatus = "activa" | "devuelta" | "parcial",
// ReservaEstado = "activa" | "entregada" | "cancelada").

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String // "admin" | "vendedor"
  nombre       String
  // Correo para "olvidé mi contraseña". Los usuarios existentes (seed previo)
  // arrancan en null hasta que se pobla vía ADMIN_EMAIL/VENDEDOR_EMAIL en el
  // seed o editándolo a mano desde /perfil. Sin correo, /api/auth/forgot
  // simplemente no manda nada (sigue respondiendo 200 genérico).
  email        String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  lotes               Lote[]
  sales               Sale[]               @relation("SaleVendedor")
  // Tickets que ESTE usuario anuló (no que vendió). Relación aparte de
  // `sales` porque quien anula casi nunca es quien vendió, y el compromiso
  // público exige saber ambos nombres. Ver Sale.anuladaPorUserId.
  salesAnuladas       Sale[]               @relation("SaleAnuladaPor")
  returns             Return[]
  reservas            Reserva[]
  auditLogs           AuditLog[]
  asientos            Asiento[]
  passwordResetTokens PasswordResetToken[]
}

// Rate-limit propio de "olvidé mi contraseña", separado de LoginAttempt: el
// disparador es el envío de un correo (costo distinto, y no queremos que
// alguien golpeando forgot bloquee también el login del mismo username, ni
// viceversa). Mismo estilo/índices que LoginAttempt (ver lib/auth.ts).
model PasswordResetAttempt {
  id        String   @id @default(uuid())
  username  String
  ip        String
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

// Token de un solo uso para resetear contraseña por correo. Solo se guarda el
// HASH (SHA-256) del token, nunca el valor en claro — el token de 32 bytes al
// azar ya tiene entropía suficiente para no necesitar bcrypt acá. Expira en
// 30 min (ver lib/password-reset.ts) y se invalida (usedAt) al usarse, junto
// con cualquier otro token vivo del mismo usuario.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Rate-limit / lockout de login. Se consulta por username en una ventana de tiempo.
// Nunca se guarda el password intentado.
model LoginAttempt {
  id        String   @id @default(uuid())
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

// Configuración global editable desde admin/Perfil. Fila única (id fijo = 1).
model AppConfig {
  id                    Int       @id @default(1)
  // ₡ por USD, x100 para precisión (510.00 -> 51000). Usado para derivar
  // Lote.costoTotalCent desde Lote.costoTotalUsdCent. ESTIMADO hasta
  // confirmar con el estado de cuenta real de la tarjeta.
  tipoCambioUsdCent     Int       @default(51000)
  // "BAC/BCCR ventanilla" (automático, ver lib/tipo-cambio-bac.ts) o "manual"
  // (Cris lo editó a mano en Perfil — el refresh diario NO lo pisa hasta el
  // día siguiente, o hasta que se toque "Actualizar ahora").
  tipoCambioFuente      String    @default("manual")
  // Última vez que tipoCambioUsdCent cambió (automático o manual).
  tipoCambioActualizado DateTime?
  // Cris no está formalizado ante Hacienda todavía: mientras esté en false,
  // el precio cobrado ES el ingreso completo (sin desglose de IVA). Al
  // formalizarse, activar acá — la lógica de venta vuelve a derivar
  // base/IVA al 13% sin tocar código (ver lib/money.ts, app/api/sales).
  ivaActivo             Boolean   @default(false)
  // Día del mes en que corta el estado de cuenta de la tarjeta de crédito
  // (ej. 21). Un lote comprado con tarjeta en o antes de este día vence el
  // mismo día del mes SIGUIENTE; comprado después, vence el mismo día del mes
  // SUBSIGUIENTE. Ver lib/lote.ts#computeFechaVencimientoPago. Editable en
  // Perfil (admin).
  diaCorteTarjeta       Int       @default(21)
  updatedAt             DateTime  @updatedAt
}

model Model {
  id          String  @id @default(uuid())
  nombre      String
  sku         String?
  fotoUrl     String?
  // Foto guardada EN LA DB (bytea) para que persista en serverless (Netlify).
  // El buffer ya viene procesado (magic-bytes + sharp + EXIF strip). Se sirve
  // por /api/uploads/models/[filename] leyendo de acá.
  fotoData    Bytes?
  fotoMime    String?
  cabys       String?
  categoria   String?
  descripcion String?

  // precio de venta al público, con IVA por default (ver Sale.precioIncluyeIva)
  precioVentaCent Int

  activo Boolean @default(true)

  // Unidades disponibles para vender de ESTE modelo/nombre. El COSTO ya no
  // vive acá (ver nota de costeo pooled arriba) — esto es solo un contador de
  // unidades por bucket con nombre (los 8 modelos nombrados + "Sin
  // especificar" para el resto del inventario sin identificar).
  stockQty Int @default(0)

  // Unidades apartadas (reservadas) que restan de lo vendible pero siguen
  // físicamente en inventario hasta entregarse. Ver modelo Reserva.
  stockReservado Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]
  reservas  Reserva[]
  lotes     Lote[]

  @@index([activo])
}

// Lote de compra de inventario, atado al MODELO/SKU que recibió sus unidades
// (`modelId`). Inmutable — nunca se edita después de creado; es el ledger
// financiero de costo. Si un mismo envío físico trae varios SKU, se registra
// un Lote por SKU (así llegó la factura NHCR607272277300: una fila de lentes
// y una de estuches).
model Lote {
  id                   String    @id @default(uuid())
  fecha                DateTime
  unidades             Int
  costoTotalUsdCent    Int // en centavos de USD (ej. $80.00 -> 8000)
  costoTotalCent       Int // derivado a ₡ con el tipo de cambio vigente al momento de crear el lote
  moneda               String    @default("USD")
  medioPago            String    @default("tarjeta_credito")
  fechaVencimientoPago DateTime?
  pagado               Boolean   @default(false)
  // Tipo de cambio (₡/USD x100) congelado en el momento en que el lote se
  // marca `pagado=true`. Mientras `pagado=false`, el costo en ₡ de este lote
  // FLOTA con el tipo de cambio vigente (ver lib/lote.ts#costoLoteEnColonesCent)
  // — este campo se llena una sola vez, al pagar, y ya no cambia después.
  tipoCambioPagoCent   Int?

  // SKU que recibió estas unidades. Es lo que permite promediar el costo POR
  // MODELO en vez de globalmente (ver nota de costeo arriba y lib/lote.ts).
  // Nullable solo por compatibilidad con filas anteriores a la migración
  // 20260816120000; toda alta nueva lo escribe (`app/api/admin/lotes` ya
  // recibía `modelId` para sumar el stock, solo que no lo guardaba). Un lote
  // sin modelo cae al pool "sin asignar", que NO contamina el costo de ningún
  // SKU con lotes propios.
  modelId String?
  model   Model?  @relation(fields: [modelId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([fecha])
  @@index([pagado])
  @@index([modelId])
}

// Venta = TICKET (puede incluir varios modelos). Append-only: la fila NUNCA se
// borra. El monto lo teclea Cris a nivel de ticket (no por par) — ver SaleItem
// para el desglose por modelo.
//
// DOS FORMAS DE CORREGIR, Y NO SON INTERCAMBIABLES (auditoría 16-ago-2026):
//
//  · `Return` — el cliente DEVOLVIÓ producto. Hubo venta, hubo entrega, hubo
//    reingreso de mercadería y salida de plata. Deja `estado` en "devuelta" o
//    "parcial" según cuánto volvió.
//  · `estado = "anulada"` — el ticket NO DEBIÓ EXISTIR (dedazo, monto mal
//    tecleado, venta duplicada). No volvió nada porque nunca salió nada.
//
// Anular NO es devolver, y usar `Return` para un dedazo corrompe dos cifras:
// inventa una devolución que nunca ocurrió, y la métrica pública de /socios
// resta `Return.cantidadDevuelta` del mes (docs/METAS_UMBRALES.md §9.1) — o
// sea que un ticket fantasma se contaría como vendido-y-devuelto en vez de
// como nunca vendido. Por eso es estado propio y no una fila de Return.
//
// HISTORIA: hasta el 16-ago-2026 `DELETE /api/sales/[id]` borraba la fila de
// verdad. 5 ventas desaparecieron así (ver docs/AUDITORIA_VENTAS_BORRADAS.md).
// Hoy el borrado físico está bloqueado por trigger en Postgres, no solo por
// código — ver migrations/20260816130000_sale_anulacion.
model Sale {
  id    String   @id @default(uuid())
  fecha DateTime @default(now())

  totalCent        Int // monto TOTAL del ticket, tecleado por Cris (bruto)
  precioIncluyeIva Boolean @default(true) // si `totalCent` ya incluía IVA (relevante solo si ivaActivo=true)

  // derivados (ver lib/money.ts#deriveIvaConfigurable): con ivaActivo=false,
  // baseCent=totalCent e ivaCent=0.
  baseCent Int
  ivaCent  Int

  // CORAZÓN de la auditoría: COGS del ticket completo = SUM(SaleItem.cogsLineCent).
  cogsCent     Int
  utilidadCent Int // baseCent - cogsCent

  // "activa" | "anulada" | "devuelta" | "parcial".
  // Solo "activa" cuenta para cifras (Panel y métrica pública). El único lugar
  // donde eso se decide es lib/sale-estado.ts — no escribir el literal suelto
  // en una consulta nueva, o dashboard y landing se van a separar.
  estado String @default("activa")

  // --- ANULACIÓN LÓGICA ---
  // Los tres campos van juntos o no va ninguno: hay un CHECK en Postgres que
  // impide `estado='anulada'` sin motivo, autor y fecha. Una anulación sin
  // autor no es auditable, y el compromiso público de /socios promete que un
  // tercero pueda revisar por qué una cifra cambió.
  anuladaEn        DateTime?
  anulacionMotivo  String?
  anuladaPorUserId String?
  anuladaPor       User?     @relation("SaleAnuladaPor", fields: [anuladaPorUserId], references: [id])

  clienteNombre String?
  clienteId     String?
  formaPago     String?

  userId String
  user   User   @relation("SaleVendedor", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  items   SaleItem[]
  returns Return[]

  @@index([userId, fecha])
  @@index([fecha])
  // La métrica pública agrupa por mes filtrando estado: sin este índice hace
  // seq scan sobre toda la tabla en cada corte.
  @@index([estado, fecha])
  @@index([anuladaPorUserId])
}

// Línea de un ticket: un modelo + cantidad dentro de una Sale. Inmutable.
model SaleItem {
  id     String @id @default(uuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  modelId String
  model   Model  @relation(fields: [modelId], references: [id])

  cantidad Int

  // Snapshot pooled (SUM Lote.costoTotalCent / SUM Lote.unidades) al momento
  // de vender — el MISMO valor para todos los ítems de un mismo ticket,
  // prorrateado igual sin importar el modelo.
  costoUnitSnapshotCent Int
  cogsLineCent          Int // cantidad * costoUnitSnapshotCent, guardado para auditoría

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([modelId])
}

// DEVOLUCIÓN de mercadería: el cliente trajo el producto de vuelta. Es un
// hecho económico nuevo (entra inventario, sale plata), no una corrección de
// tecleo — para eso está `Sale.estado='anulada'`, ver la nota en Sale.
// Sigue siendo cierto que nunca se borra ni edita una Sale.
model Return {
  id     String   @id @default(uuid())
  saleId String
  sale   Sale     @relation(fields: [saleId], references: [id])
  fecha  DateTime @default(now())

  cantidadDevuelta      Int
  costoUnitSnapshotCent Int // heredado de Sale, no recalculado

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// Reserva: aparta stock (stockReservado) sin contar como ingreso hasta que se
// entrega (se convierte en Sale — flujo de conversión pendiente, TODO).
// Soporte de datos listo; sin UI de creación todavía (cantidad real la define
// Cris, no se inventa acá — ver seed.ts).
model Reserva {
  id             String    @id @default(uuid())
  modelId        String
  model          Model     @relation(fields: [modelId], references: [id])
  cantidad       Int
  precioUnitCent Int
  fecha          DateTime  @default(now())
  estado         String    @default("activa") // "activa" | "entregada" | "cancelada"
  entregadaEn    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([modelId, estado])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  accion    String
  entidad   String
  entidadId String
  detalle   String // JSON serializado
  createdAt DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([createdAt])
}

// ============================================================
// LANDING PÚBLICA B2B (/socios) — captura de leads de puntos de venta
// ============================================================

// Solicitud de un negocio (tienda/boutique/hotel/surf shop/óptica) que quiere
// vender bloo. Append-only, sin UI de administración todavía (se revisa vía
// Prisma Studio o consulta directa — TODO: vista admin si el volumen lo pide).
// No lleva datos de dinero: nada de convención de céntimos acá.
model SocioLead {
  id     String @id @default(uuid())
  nombre String // quién llena el formulario
  negocio String // nombre del negocio/tienda
  // "boutique" | "hotel_resort" | "surf_shop" | "optica" | "souvenirs" | "otro"
  // (ver docs/COPY_SOCIOS.md §07, campo `tipo`)
  tipoNegocio String
  canton String // dónde está el punto de venta (docs/COPY_SOCIOS.md campo `canton`)
  whatsapp String // obligatorio en el copy — "por aquí le mandamos el catálogo"
  correo String? // opcional en el copy (a diferencia de whatsapp)
  mensaje String?

  // IP vía lib/auth.ts#getClientIp (mismo criterio "untrusted" sin proxy
  // confiable configurado) — solo fines forenses/anti-spam, no de negocio.
  ip String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// MÓDULO CONTABLE (partida doble)
// ============================================================

// Plan de cuentas. Cada asiento mueve varias cuentas (debe/haber).
model Cuenta {
  id         String   @id @default(uuid())
  codigo     String   @unique // "1-1-001"
  nombre     String
  tipo       String // "activo" | "pasivo" | "patrimonio" | "ingreso" | "gasto"
  naturaleza String // "deudora" | "acreedora"
  // true = es un medio de pago (Caja, SINPE Cris/Sara, Datáfono) -> aparece en
  // el selector de medio de pago de las plantillas.
  esMedioPago Boolean @default(false)

  // Comisión que el procesador RETIENE sobre lo cobrado por este medio de
  // pago, en PUNTOS BÁSICOS (1 bps = 0,01 %; 350 bps = 3,50 %). Entero, misma
  // regla que el dinero: nunca Float.
  //
  // Default 0 A PROPÓSITO — mientras nadie confirme la tarifa real con el
  // adquirente, el sistema NO inventa un porcentaje: no genera asiento de
  // comisión y la cuenta 5-2-002 queda en cero, que es honesto. Cuando Cris
  // confirme la tarifa la escribe en /conta → Cuentas y a partir de ahí cada
  // venta con ese medio asienta la comisión sola (ver app/api/sales/route.ts).
  //
  // Debe ser la tasa TOTAL retenida: si el adquirente cobra IVA sobre su
  // comisión, va incluido acá. La app no desglosa el IVA de la comisión —
  // `AppConfig.ivaActivo=false`, bloo no acredita IVA todavía.
  comisionBps Int @default(0)

  activo      Boolean @default(true)
  createdAt   DateTime @default(now())

  // Subcuentas jerárquicas, profundidad MÁXIMA 1 (una hija no puede tener
  // hijas). La cuenta madre (parentId=null, con hijas.length>0) NUNCA recibe
  // asientos propios: su saldo se calcula SUMANDO el de sus hijas
  // (ver lib/conta.ts#cuentasConSaldo → saldoConsolidadoCent). Esto es
  // garantía contable, no solo de UI — si se permitiera asentar contra la
  // madre Y sumar las hijas, el saldo se duplicaría. La garantía real vive en
  // 2 triggers de Postgres (ver
  // prisma/migrations/20260815010000_cuentas_jerarquia/migration.sql), porque
  // hay asientos automáticos (origen "pago_lote" / "cobro_reserva" / futura
  // "venta") que no pasan por el formulario manual y se saltarían cualquier
  // chequeo hecho solo en la app. NO quitar `parentId` ni esos triggers sin
  // entender esto primero.
  parentId String?
  parent   Cuenta?  @relation("CuentaJerarquia", fields: [parentId], references: [id])
  hijas    Cuenta[] @relation("CuentaJerarquia")

  lineas LineaAsiento[]

  @@index([tipo, codigo])
  @@index([parentId])
}

// Asiento = un movimiento contable con N líneas que CUADRAN (Σdebe = Σhaber).
// Append-only: no se edita; corrección = asiento inverso.
model Asiento {
  id        String   @id @default(uuid())
  fecha     DateTime
  glosa     String
  // "manual" | "pago_lote" | "cobro_reserva" | "venta" | "venta_anulada"
  // | "venta_borrada" (HISTÓRICO: contra-asientos de las ventas que se
  //   borraron físicamente antes del 16-ago-2026. No se genera más; sus
  //   `refId` apuntan a filas que ya no existen —
  //   ver docs/AUDITORIA_VENTAS_BORRADAS.md).
  origen    String   @default("manual")
  refId     String? // id del Lote/Reserva/Sale si viene de una plantilla
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  lineas LineaAsiento[]

  @@index([fecha])
}

// Una línea del asiento: una cuenta con monto en DEBE o en HABER (uno de los dos).
model LineaAsiento {
  id        String  @id @default(uuid())
  asientoId String
  asiento   Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  cuentaId  String
  cuenta    Cuenta  @relation(fields: [cuentaId], references: [id])
  debeCent  Int     @default(0)
  haberCent Int     @default(0)

  @@index([asientoId])
  @@index([cuentaId])
}
